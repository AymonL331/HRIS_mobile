<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- IN-APP UPDATE (2026-09-15): the app downloads a newer signed APK from the HRIS
         server and hands it to Android's own installer, which always asks the
         employee to confirm. Android also asks once to allow "Install unknown apps"
         for HRIS. Remove this (and the self-update) if the app moves to Google Play. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Location is MANDATORY, PRECISE and ALWAYS (2026-09-14): the app is blocked
         unless the employee has granted "Allow all the time" with "Use precise
         location" on. Fine + coarse are both declared because Android 12+ only
         offers the Precise toggle when it sees them.

         BACKGROUND IS REQUESTED SEPARATELY, after foreground is already granted.
         Android 11+ silently ignores a request that mixes foreground and
         background location — granting neither, with no dialog — and geolocator's
         own requestPermission() will bundle them the moment the current status is
         `whileInUse`. See the loud comment in core/location/location_gate_service
         .dart; the background ask goes through permission_handler instead.

         WORK-HOURS TRACKING (2026-09-14) is what collects: a foreground service of
         type `location` (declared below, with its permissions) records the trail
         from clock-in to clock-out behind a visible notification. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>
    <!-- The setup wizard's two optional steps (2026-09-14). POST_NOTIFICATIONS:
         Android 13+ shows no notification dialog unless it is declared.
         REQUEST_IGNORE_BATTERY_OPTIMIZATIONS: the "Let app always run in
         background?" dialog — without the exemption most phones sold here stop a
         background app within minutes, which would end work-hours tracking. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- The work-hours tracking service (flutter_foreground_task). Android 14+
         refuses to start a foreground service without its TYPE permission;
         RECEIVE_BOOT_COMPLETED lets a shift that was open when the phone
         restarted resume recording (location FGS may start from boot, unlike
         dataSync on Android 15). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- CLOCK-IN / CLOCK-OUT REMINDERS (2026-09-17): the app arms one EXACT alarm
         per reminder stage HR configured on the website, wakes at that time and
         asks the server whether a reminder was actually sent. USE_EXACT_ALARM is
         granted without a dialog on Android 13+ (reserved for alarm/reminder
         apps; Google Play restricts it, which does not apply to this in-house
         APK — same standing as REQUEST_INSTALL_PACKAGES above). Android 12
         still needs SCHEDULE_EXACT_ALARM, which the employee can allow from
         Settings › Phone. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32"/>
    <!-- The face check that gates every punch (2026-09-13). Requested at the
         moment of the first capture, never at launch. `required="false"` on the
         feature so the app still installs on a device with no front camera —
         it then says so instead of being unlistable. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.front" android:required="false"/>
    <application
        android:label="HRIS"
        android:networkSecurityConfig="@xml/network_security_config"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- The work-hours location tracking service. The name is the plugin's
             and must not change. stopWithTask false: swiping HRIS out of recents
             must NOT end recording mid-shift — only clock-out (or the server
             saying the shift closed) does. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="location"
            android:stopWithTask="false"
            android:exported="false" />
        <!-- The reminder alarms (android_alarm_manager_plus). The plugin declares
             none of these itself: the service runs the Dart callback when an
             alarm fires, the first receiver is what the alarm wakes, and the
             reboot receiver re-arms the alarms after a restart (the plugin turns
             it on only while an alarm asked to survive one). -->
        <service
            android:name="dev.fluttercommunity.plus.androidalarmmanager.AlarmService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false"/>
        <receiver
            android:name="dev.fluttercommunity.plus.androidalarmmanager.AlarmBroadcastReceiver"
            android:exported="false"/>
        <receiver
            android:name="dev.fluttercommunity.plus.androidalarmmanager.RebootBroadcastReceiver"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <!-- IN-APP UPDATE: shares ONLY the downloaded update (cache/updates/) with
             Android's installer — see res/xml/update_file_paths.xml. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.update_provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_file_paths" />
        </provider>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
